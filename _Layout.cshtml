
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark raceday-nav">
            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    🏁 RaceDay
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">

                    <div class="navbar-nav me-auto">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Events
                        </a>

                        @* ORGANISER NAVIGATION *@
                        @if (Context.Session.GetString("Role") == "Organiser")
                        {
                            <a class="nav-link"
                               asp-controller="Organiser"
                               asp-action="Index">
                                Manage Events
                            </a>

                            <a class="nav-link"
                               asp-controller="Organiser"
                               asp-action="Categories">
                                Manage Categories
                            </a>
                        }

                        @* PARTICIPANT NAVIGATION *@
                        @if (Context.Session.GetString("Role") == "Participant")
                        {
                            <a class="nav-link"
                               asp-controller="Participant"
                               asp-action="MyEnrolments">
                                My Enrolments
                            </a>

                            <a class="nav-link"
                               asp-controller="Participant"
                               asp-action="MyResults">
                                My Results
                            </a>

                            <a class="nav-link"
                               asp-controller="Participant"
                               asp-action="Profile">
                                Profile
                            </a>
                        }

                    </div>

                    <div class="navbar-nav align-items-lg-center">

                        @if (Context.Session.GetString("Role") is not null)
                        {
                            <span class="navbar-text me-lg-3">
                                Hi, @Context.Session.GetString("Name")
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button class="btn btn-outline-light btn-sm"
                                        type="submit">
                                    Log out
                                </button>

                            </form>
                        }
                        else
                        {
                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Log in
                            </a>

                            <a class="btn btn-warning btn-sm ms-lg-2"
                               asp-controller="Account"
                               asp-action="Register">
                                Join RaceDay
                            </a>
                        }

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-warning">@error</div>
        }

        @RenderBody()

    </main>

    <footer class="container py-4 text-center text-secondary small">
        RaceDay • Move together. Finish stronger.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

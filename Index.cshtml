@model List<EventViewModel>
@{
    ViewData["Title"] = "Upcoming events";
}
<section class="hero p-4 p-md-5 mb-4 rounded-4">
    <span class="badge text-bg-warning mb-2">YOUR NEXT START LINE</span>
    <h1 class="display-5 fw-bold">Find your next challenge.</h1>
    <p class="lead mb-0">Run, walk or cycle. Your RaceDay starts here.</p>
</section>
<form method="get" class="row g-2 mb-4">
    <div class="col-md-7"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search by event or location" aria-label="Search events" /></div>
    <div class="col-md-3">
        <select class="form-select" name="eventType" aria-label="Filter event type">
            <option selected="@(ViewBag.EventType == "All")" value="All">All event types</option>
            <option selected="@(ViewBag.EventType == "Run")" value="Run">Run</option>
            <option selected="@(ViewBag.EventType == "Walk")" value="Walk">Walk</option>
            <option selected="@(ViewBag.EventType == "Cycle")" value="Cycle">Cycle</option>
        </select>
    </div>
    <div class="col-md-2 d-grid"><button class="btn btn-primary">Find events</button></div>
</form>
@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2 class="h4">No events to show yet</h2>
        <p class="mb-0">The API may be unavailable, or there are no events matching your search. Check that the Part 2 API is running and that Api:BaseUrl is correct.</p>
    </div>
}
else
{
    <div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <article class="card event-card h-100">
                @if (!string.IsNullOrWhiteSpace(item.BannerImageUrl))
                { <img src="@item.BannerImageUrl" class="card-img-top event-image" alt="Banner for @item.Name" /> }
                else
                { <div class="event-placeholder" aria-hidden="true">🏃‍♀️</div> }
                <div class="card-body d-flex flex-column">
                    <span class="badge event-type align-self-start mb-2">@item.EventType</span>
                    <h2 class="h5 fw-bold">@item.Name</h2>
                    <p class="text-secondary small mb-2">📍 @item.Location</p>
                    <p class="mb-3">@item.Date.ToString("dd MMM yyyy") · @item.Distance km</p>
                    <a class="btn btn-outline-primary mt-auto" asp-action="Details" asp-route-id="@item.Id">View event</a>
                </div>
            </article>
        </div>
    }
    </div>
}

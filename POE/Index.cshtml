@model List<EventViewModel>
@{
    ViewData["Title"] = "Organiser dashboard";
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div><span class="eyebrow">ORGANISER SPACE</span><h1 class="h2 fw-bold mb-0">Event dashboard</h1></div>
    <a class="btn btn-warning" asp-action="Create">＋ Create event</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="stat-card"><span>Total events returned by API</span><strong>@Model.Count</strong></div></div>
    <div class="col-md-4"><div class="stat-card"><span>Upcoming events</span><strong>@Model.Count(e => e.Date >= DateTime.Today)</strong></div></div>
    <div class="col-md-4"><div class="stat-card"><span>Enrolment count</span><strong>@Model.Sum(e => e.EnrolmentCount)</strong></div></div>
</div>
<div class="card border-0 shadow-sm"><div class="table-responsive">
<table class="table align-middle mb-0">
    <thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Enrolments</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td class="fw-semibold">@item.Name</td><td>@item.Date.ToString("dd MMM yyyy")</td><td>@item.Location</td><td><span class="status-pill">@item.EnrolmentCount</span></td><td>
            <div class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
            <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this event?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Delete</button></form></div>
        </td></tr>
    }
    </tbody>
</table></div></div>
<p class="text-secondary small mt-3">Categories, enrolment lists and results entry must be connected to their exact Part 2 API endpoints.</p>
